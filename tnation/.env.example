# Required in production (NODE_ENV=production refuses to start without them)
NODE_ENV=production
SITE_URL=https://www.your-domain.com
SESSION_SECRET=replace-with-64-random-hex-chars
ADMIN_EMAIL=you@your-domain.com
ADMIN_PASSWORD=a-long-unique-password

# Contact details shown on the site (placeholders until set)
CONTACT_EMAIL=hello@your-domain.com
WHATSAPP_NUMBER=91XXXXXXXXXX
NOTIFY_EMAIL=team@your-domain.com

# Email notifications (without SMTP, notifications are written to data/outbox/)
SMTP_HOST=smtp.your-provider.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="T Nation website <no-reply@your-domain.com>"

# Optional: Cloudflare Turnstile (extra spam protection on every public form)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Optional
PORT=3000
DATA_DIR=./data
MAX_UPLOAD_MB=25
# Set to the number of proxies in front of the app (e.g. 1) so rate limits see real client IPs
TRUST_PROXY=1
